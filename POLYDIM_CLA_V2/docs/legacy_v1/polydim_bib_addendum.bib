% ============================================================
% CITA 1 — Invariant Subspace Necessity Theorem
% Justifica H2: subespacios semánticos son linealmente invariantes
% en transformers por necesidad arquitectural (no por hipótesis)
% ============================================================

@article{suarez2026invariant,
  author    = {Suarez, Andres and Lee, Yousung and Har, Dongsoo},
  title     = {Why Linear Interpretability Works: Invariant Subspaces
               as a Result of Architectural Constraints},
  journal   = {arXiv preprint arXiv:2602.09783},
  year      = {2026},
  month     = {February},
  url       = {https://arxiv.org/abs/2602.09783},
  institution = {Korea Advanced Institute of Science and Technology (KAIST)},
  note      = {Theorem 3.7 (Invariant Subspace Necessity): any semantic
               feature decoded through a linear interface occupies a
               context-invariant subspace. Corollary B.3: the OV circuit
               maps feature directions as $d_f \mapsto W_O W_V d_f$,
               preserving subspace structure. Directly justifies Hypothesis H2
               of POLYDIM Theorem 3 (PROJECT is a functor).}
}

% ============================================================
% CITA 2 — Self-Attention as Parametric Endofunctor
% Valida que ATTEND es un endofunctor F: Vect → Vect y que
% el stacking de capas = mónada libre Free(F)
% Esto es exactamente lo que COMPOSE + PROJECT formalizan en POLYDIM
% ============================================================

@article{oneill2025endofunctor,
  author    = {O'Neill, Charles},
  title     = {Self-Attention as a Parametric Endofunctor:
               A Categorical Framework for Transformer Architectures},
  journal   = {arXiv preprint arXiv:2501.02931},
  year      = {2025},
  month     = {January},
  url       = {https://arxiv.org/abs/2501.02931},
  institution = {Australian National University},
  note      = {Theorem 3.1: linear self-attention (Q, K, V) defines a
               parametric 1-morphism in the 2-category Para(Vect), inducing
               an endofunctor F: Vect → Vect on the underlying 1-category.
               Theorem 3.2: stacking n attention layers = free monad Free(F).
               Validates the categorical structure of POLYDIM COMPOSE and
               PROJECT_X as a functor.}
}

